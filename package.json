{
  "name": "openmausbot",
  "private": true,
  "version": "0.1.124",
  "description": "A local-first chat app for running a team of AI agents.",
  "homepage": "https://github.com/milind-soni/OpenMausBot",
  "repository": {
    "type": "git",
    "url": "https://github.com/milind-soni/OpenMausBot.git"
  },
  "author": {
    "name": "Milind Soni",
    "email": "46266943+milind-soni@users.noreply.github.com"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "lint": "oxlint --deny-warnings .",
    "check:contrast": "node scripts/check-skin-contrast.mjs",
    "i18n:check": "node scripts/generate-locale.mjs --check",
    "dev": "vite",
    "docs:dev": "pnpm --filter @openmausbot/docs dev",
    "docs:build": "pnpm --filter @openmausbot/docs build",
    "docs:preview": "pnpm --filter @openmausbot/docs preview",
    "companion": "node --experimental-strip-types companion/src/index.ts",
    "omb": "node --experimental-strip-types server/openmausbot.ts",
    "pair": "node --experimental-strip-types server/openmausbot.ts pair",
    "dev:server": "node --experimental-strip-types server/dev-server.ts",
    "mcp": "node --experimental-strip-types scripts/mcp-server.ts",
    "control:omb": "node --experimental-strip-types scripts/control-omb.ts",
    "eval": "node --experimental-strip-types evals/runners/run-evals.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "test": "vitest run && pnpm broker:test && pnpm test:client && pnpm test:packaged-server",
    "bench:observation": "node --experimental-strip-types scripts/bench-observation.ts",
    "bench:persistence": "node --experimental-strip-types scripts/bench-persistence.ts",
    "bench:today": "node --experimental-strip-types scripts/bench-today.ts",
    "bench:browser-stream": "node --experimental-strip-types scripts/bench-browser-stream.ts",
    "test:watch": "vitest",
    "test:cua-container": "node scripts/smoke-cua-container.mjs",
    "preview": "vite preview",
    "gen:bodies": "node --experimental-strip-types scripts/gen-mascot-bodies.ts",
    "gen:halloween": "node --experimental-strip-types scripts/gen-halloween-bodies.ts",
    "build:server": "tsc -p tsconfig.server.build.json && node scripts/bundle-server.mjs",
    "build:companion": "tsc -p tsconfig.companion.build.json && node scripts/mark-module-scope.mjs dist-companion",
    "build:cloudflared": "node scripts/prepare-cloudflared.mjs",
    "build:browser": "node scripts/prepare-browser.mjs",
    "build:duckdb": "node scripts/prepare-duckdb.mjs",
    "smoke:browser": "node scripts/smoke-browser-bundle.mjs",
    "test:packaged-server": "pnpm build:server && node scripts/smoke-packaged-server.mjs",
    "broker:types": "wrangler types --config cloudflare/composio-broker/wrangler.jsonc cloudflare/composio-broker/worker-configuration.d.ts",
    "broker:check": "pnpm broker:types && tsc -p cloudflare/composio-broker/tsconfig.json",
    "broker:test": "vitest run --config cloudflare/composio-broker/vitest.config.ts",
    "broker:deploy": "wrangler deploy --config cloudflare/composio-broker/wrangler.jsonc",
    "control-plane:types": "pnpm --filter @openmausbot/control-plane types",
    "control-plane:check": "pnpm --filter @openmausbot/control-plane check",
    "control-plane:test": "pnpm --filter @openmausbot/control-plane test",
    "control-plane:dry-run": "pnpm --filter @openmausbot/control-plane dry-run",
    "test:client": "node --test \"shared/client/*.node-test.mjs\""
  },
  "dependencies": {
    "@1password/sdk": "0.5.0",
    "@clack/prompts": "1.7.0",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@duckdb/node-api": "1.5.6-r.1",
    "@hpke/core": "1.9.0",
    "@lezer/highlight": "1.2.5",
    "@muse-code/sdk": "1.4.6",
    "@novnc/novnc": "1.7.0",
    "@resvg/resvg-js": "2.6.2",
    "@tanstack/react-virtual": "^3.14.13",
    "@trycua/cua-driver": "0.28.2",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "clsx": "^2.1.1",
    "codemirror": "6.0.2",
    "croner": "10.0.1",
    "jmespath": "0.16.0",
    "jose": "6.2.10",
    "katex": "^0.16.47",
    "lucide-react": "^0.539.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mermaid": "^12.1.0",
    "papaparse": "^5.7.0",
    "posthog-js": "^1.415.6",
    "qrcode-terminal": "0.12.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.3.1",
    "tar": "7.5.22",
    "tldts": "7.4.18",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-lite": "6.5.0",
    "vega-themes": "3.0.0",
    "ws": "8.22.0",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@tailwindcss/vite": "^4.1.11",
    "@types/jmespath": "0.15.2",
    "@types/node": "^26.2.0",
    "@types/novnc__novnc": "1.6.0",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode-terminal": "0.12.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "oxlint": "1.80.0",
    "tailwindcss": "^4.1.11",
    "typebox": "1.3.7",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.11",
    "wrangler": "4.123.0"
  }
}
